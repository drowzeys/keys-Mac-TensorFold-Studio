# GHCR carrier for keys-Mac TensorFold Studio. This is NOT a runtime: Metal does not run in a container. It carries
# the pinned TensorFold wheel (with the H3 and Qwen-Image families), the dependency lock and the render scripts;
# oneshot-setup.sh copies them out and installs natively on the Mac. It holds no model weights.
#
#   docker run --rm -v "$PWD":/out ghcr.io/drowzeys/keys-mac-tensorfold-studio:1.0 cp -a /payload/. /out/
FROM busybox:1.37
LABEL org.opencontainers.image.source="https://github.com/drowzeys/keys-Mac-TensorFold-Studio"
LABEL org.opencontainers.image.description="Carrier (not a runtime): TensorFold 0.6.5 + MiniMax H3 and Qwen-Image-2.1 families wheel, dependency lock and render scripts for Apple Silicon"
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY payload/ /payload/
